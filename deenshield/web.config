<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Force HTTPS for this site -->
    <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
      <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <!-- Allow ACME HTTP-01 validation without redirect -->
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Ensure site root serves main.html -->
        <rule name="DeenShield Root to main.html" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="main.html" />
        </rule>
        <!-- Clean URLs: /page -> /page.html if the file exists -->
        <rule name="DeenShield Extensionless to .html" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
      <outboundRules>
        <!-- Prevent HTML caching so updates show immediately -->
        <rule name="CacheControl-HTML" preCondition="IsHTML">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="no-store, no-cache, must-revalidate" />
        </rule>
        <!-- Cache CSS/JS moderately (1 day) -->
        <rule name="CacheControl-CSSJS">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="\.(css|js)(\?.*)?$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" value="public, max-age=86400, must-revalidate" />
        </rule>
        <!-- Cache images/fonts longer (7 days) -->
        <rule name="CacheControl-Assets">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="\.(png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf|eot)(\?.*)?$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" value="public, max-age=604800" />
        </rule>
        <preConditions>
          <preCondition name="IsHTML">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <defaultDocument>
      <files>
        <clear />
        <add value="main.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Ensure correct content types for modern assets if needed -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
