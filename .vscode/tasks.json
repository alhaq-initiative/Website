{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run AmnShield Desktop Manager",
			"type": "shell",
			"command": "npm",
			"args": [
				"start",
				"--prefix",
				"AmnShield-Desktop-Manager"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "Run Cypress smoke tests",
			"type": "shell",
			"command": "npx",
			"args": [
				"cypress",
				"run",
				"--browser",
				"chrome",
				"--headless"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "Run local smoke checks",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"smoke"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Deploy Firebase Hosting (all targets)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"deploy:all"
			],
			"isBackground": false,
			"group": "build"
		}
	]
}