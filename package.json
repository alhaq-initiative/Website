{
  "name": "alhaq-initiative-website",
  "version": "1.0.0",
  "description": "Al-Haq Initiative — static website with Islamic digital tools",
  "scripts": {
    "serve": "python -m http.server 8080",
    "dev": "live-server --port=8080 --entry-file=index.html",
    "lint": "eslint . --ext .js,.html",
    "lint:fix": "eslint . --ext .js,.html --fix",
    "format": "prettier --write .",
    "deploy": "npx -y firebase-tools deploy --only hosting:initiative",
    "deploy:main": "npx -y firebase-tools deploy --only hosting:initiative",
    "deploy:all": "npx -y firebase-tools deploy --only hosting:initiative",
    "chatbot:index": "python3 scripts/build_site_index.py",
    "content:index": "node scripts/build-content-index.mjs",
    "library:import": "node scripts/normalise-notion-md.mjs",
    "library:import:setup": "python -m pip install markitdown",
    "library:import:docs": "python scripts/import_markitdown.py",
    "integrity": "node tests/local-integrity.mjs",
    "smoke": "node tests/e2e-smoke.mjs",
    "test": "node tests/comprehensive-tests.mjs",
    "test:translations": "node tests/check-translations.mjs",
    "prepare": "husky install"
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "firebase-tools": "^13.35.1",
    "husky": "^8.0.0",
    "lint-staged": "^16.1.4",
    "live-server": "^1.2.2",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{js,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
