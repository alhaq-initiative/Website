{
  "name": "alhaq-initiative-website",
  "version": "1.0.0",
  "description": "Al-Haq Initiative website with AI demo functionality",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "serve": "python -m http.server 8080",
    "dev": "live-server --port=8080 --entry-file=index.html",
    "api": "node api/server.js",
    "api:dev": "nodemon api/server.js",
    "build": "echo 'Build process - will be implemented'",
    "lint": "eslint . --ext .js,.html",
    "lint:fix": "eslint . --ext .js,.html --fix",
    "format": "prettier --write .",
    "deploy": "npx firebase deploy --only hosting:main",
    "deploy:main": "npx firebase deploy --only hosting:main",
    "deploy:amn": "npx firebase deploy --only hosting:amn",
    "deploy:all": "npx firebase deploy --only hosting:main,hosting:amn",
  "test": "jest",
  "smoke": "node tests/e2e-smoke.mjs",
  "test:comprehensive": "node tests/comprehensive-tests.mjs",
  "test:comprehensive:verbose": "VERBOSE=true node tests/comprehensive-tests.mjs",
  "test:all": "npm test && npm run smoke && npm run test:comprehensive",
  "integrity": "node tests/local-integrity.mjs",
  "cy:open": "cypress open",
  "cy:run": "cypress run",
    "library:import": "node scripts/normalise-notion-md.mjs",
    "library:import:setup": "python -m pip install markitdown",
    "library:import:docs": "python scripts/import_markitdown.py",
    "content:index": "node scripts/build-content-index.mjs",
    "prepare": "husky install"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "depcheck": "^1.4.7",
    "eslint": "^9.32.0",
    "husky": "^8.0.0",
  "jest": "29.7.0",
  "jest-environment-jsdom": "29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "lint-staged": "^16.1.4",
    "live-server": "^1.2.2",
    "nodemon": "^3.1.10",
  "prettier": "^3.6.2",
  "cypress": "^13.15.0"
  },
  "lint-staged": {
    "*.{js,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
