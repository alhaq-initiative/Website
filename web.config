<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Rule 1: Force HTTPS -->
        <!-- This rule checks if the request is not using HTTPS and redirects it. -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        
        <!-- Rule 1.5: Canonicalize home URL by redirecting /index.html to / -->
        <rule name="Redirect index.html to root" stopProcessing="true">
          <match url="^index\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- Rule 1.6: Redirect any .html URL to its extensionless version for clean URLs -->
        <rule name="Redirect .html to extensionless" stopProcessing="true">
          <match url="^(.+)\.html$" />
          <conditions>
            <!-- Avoid redirect loops for files that aren't actual pages -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <!-- Exclude special directories if needed -->
            <add input="{URL}" pattern="^/(deenshield|api|admin)/.*\.html$" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Rule 1.65: Redirect locale .html URLs to extensionless (e.g., /fa/about.html -> /fa/about) -->
        <rule name="Redirect locale .html to extensionless" stopProcessing="true">
          <match url="^(ar|fa|ps)/(.+)\.html$" />
          <action type="Redirect" url="/{R:1}/{R:2}" redirectType="Permanent" />
        </rule>

        <!-- Rule 1.67: Redirect locale index to locale root (e.g., /fa/index -> /fa/) -->
        <rule name="Redirect locale index to root" stopProcessing="true">
          <match url="^(ar|fa|ps)/index$" />
          <action type="Redirect" url="/{R:1}/" redirectType="Permanent" />
        </rule>

        <!-- Rule 1.7: Serve locale-prefixed static files from root (so /fa/assets/... works) -->
        <rule name="Rewrite locale-prefixed static to root" stopProcessing="true">
          <match url="^(ar|fa|ps)/(.*)$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}{R:2}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:2}" />
        </rule>

        <!-- Rule 1.8: Support locale-prefixed URLs by rewriting /ar|/fa|/ps to underlying pages -->
        <!-- Example: /fa/about -> serves /about.html while keeping the visible URL as /fa/about -->
        <rule name="Rewrite locale-prefixed root" stopProcessing="true">
          <match url="^(ar|fa|ps)/?$" />
          <action type="Rewrite" url="index.html" />
        </rule>
        <rule name="Rewrite locale-prefixed pages to html" stopProcessing="true">
          <match url="^(ar|fa|ps)/(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}{R:2}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:2}.html" />
        </rule>
        
        <!-- Rule 2: Remove .html extension -->
        <!-- This rule rewrites a clean URL (e.g., /about) to the actual file (/about.html) on the server. -->
        <rule name="Remove .html extension" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
      <outboundRules>
        <!-- No cache for HTML to ensure UI updates show immediately -->
        <rule name="CacheControl-HTML" preCondition="IsHTML">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="no-store, no-cache, must-revalidate" />
        </rule>
        <!-- Moderate cache for CSS/JS -->
        <rule name="CacheControl-CSSJS">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="\.(css|js)(\?.*)?$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" value="public, max-age=86400, must-revalidate" />
        </rule>
        <!-- Cache images and fonts a bit longer -->
        <rule name="CacheControl-Assets">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="\.(png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf|eot)(\?.*)?$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" value="public, max-age=604800" />
        </rule>
        <preConditions>
          <preCondition name="IsHTML">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
