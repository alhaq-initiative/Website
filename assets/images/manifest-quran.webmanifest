{
  "name": "Quran Hub — Alhaq Initiative",
  "short_name": "Quran Hub",
  "description": "Read, listen, and study the Quran offline with a modern, mobile-friendly reader.",
  "start_url": "/quran.html",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#ffffff",
  "background_color": "#0A2540",
  "icons": [
    {
      "src": "/assets/images/quranhub-icon.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/assets/images/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/images/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Continue reading",
      "short_name": "Continue",
      "url": "/quran.html#resume=1",
      "icons": [ { "src": "/assets/images/quranhub-icon.png", "sizes": "96x96", "type": "image/png" } ]
    }
  ]
}
